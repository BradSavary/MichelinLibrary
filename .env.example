# Variables d'environnement pour PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=michelin_library

# URL de connexion complète pour Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/michelin_library?schema=public

# Port du backend
PORT=5000

# URL de l'API pour le frontend
VITE_API_URL=http://localhost:5000
